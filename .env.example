# `.env` にコピーして値を埋める。`.env` はコミットしない（gitignore 済み）。
# ここに書くのは秘密情報を含まないサンプル値。各自の値に置き換えること。

# PostgreSQL 接続文字列（実際の認証情報は書かない）
DATABASE_URL=postgres://user:password@localhost:5432/chatwork_slack_bridge
# HTTP の待ち受けポート
PORT=3000
# pino のログレベル: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# 実行環境: development | test | production
NODE_ENV=development
# /health の DB ping のタイムアウト上限（ミリ秒）
DB_HEALTH_TIMEOUT_MS=2000

# --- forwarding（Chatwork → Slack 転送）---
# Chatwork Webhook 署名検証用トークン（base64・秘密。実値は書かない）
CHATWORK_WEBHOOK_TOKEN=
# Chatwork API（GET /rooms 等）用トークン（秘密。実値は書かない）
CHATWORK_API_TOKEN=
# Slack 投稿用 Bot トークン（chat:write スコープ・秘密。実値は書かない）
SLACK_BOT_TOKEN=
# Slack request 署名検証用シークレット（必須・秘密。実値は書かない）
SLACK_SIGNING_SECRET=
# 送信操作の allowlist（任意・カンマ区切りの Slack user ID。未設定=本人のみ許可）
SLACK_ALLOWED_REPLY_USER_IDS=
# group 種別の集約フォールバック Slack チャンネル ID（設定値）
SLACK_DEFAULT_GROUP_CHANNEL_ID=
# direct 種別の集約フォールバック Slack チャンネル ID（設定値）
SLACK_DEFAULT_DM_CHANNEL_ID=

# --- gcp backend 利用時のみ（SECRET_BACKEND=gcp）---
# 上記トークンを格納する Secret Manager のシークレット「名」（実値ではなく名前）
# CHATWORK_WEBHOOK_TOKEN_SECRET=
# CHATWORK_API_TOKEN_SECRET=
# SLACK_BOT_TOKEN_SECRET=
# SLACK_SIGNING_SECRET_SECRET=

# --- Google Chat（任意。設定手順: docs/google-chat.md）---
GOOGLE_CHAT_ENABLED=false
# 有効にする場合、下記すべての必須項目を設定する。
# GOOGLE_CHAT_ACCOUNT_EMAIL=user@example.com
# GOOGLE_CHAT_SPACE_NAME=spaces/EXAMPLE
# GOOGLE_CHAT_SPACE_DISPLAY_NAME=Example space
# GOOGLE_CHAT_SLACK_CHANNEL_ID=CEXAMPLE
# GOOGLE_CHAT_START_TIME=2026-09-15T00:00:00Z
# GOOGLE_CHAT_POLL_INTERVAL_MS=60000
# timer: app timer; external: authenticated HTTP invocation
GOOGLE_CHAT_POLL_MODE=timer
# Required only in external mode: random base64url token (32-256 characters).
# GOOGLE_CHAT_POLL_TOKEN=
# Secret Manager reference when SECRET_BACKEND=gcp:
# GOOGLE_CHAT_POLL_TOKEN_SECRET=
# 未設定は受信専用。Chatwork 用の許可ユーザー設定は継承しない。
# GOOGLE_CHAT_ALLOWED_REPLY_USER_IDS=UEXAMPLE
# env backend: OAuth JSON（client_id / client_secret / refresh_token）を設定。
# GOOGLE_CHAT_CREDENTIALS=
# gcp backend: 同じ JSON を格納した Secret Manager のシークレット名。
# GOOGLE_CHAT_CREDENTIALS_SECRET=
