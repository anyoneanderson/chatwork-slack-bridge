# Copy to `.env` and fill in. Do NOT commit `.env` (it is gitignored).
# These are non-secret sample values — replace with your own.

# PostgreSQL connection string (no real credentials here)
DATABASE_URL=postgres://user:password@localhost:5432/chatwork_slack_bridge
# HTTP listen port
PORT=3000
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# development | test | production
NODE_ENV=development
# Upper bound (ms) for the /health DB ping
DB_HEALTH_TIMEOUT_MS=2000
