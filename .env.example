# `.env` にコピーして値を埋める。`.env` はコミットしない（gitignore 済み）。
# ここに書くのは秘密情報を含まないサンプル値。各自の値に置き換えること。

# PostgreSQL 接続文字列（実際の認証情報は書かない）
DATABASE_URL=postgres://user:password@localhost:5432/chatwork_slack_bridge
# HTTP の待ち受けポート
PORT=3000
# pino のログレベル: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# 実行環境: development | test | production
NODE_ENV=development
# /health の DB ping のタイムアウト上限（ミリ秒）
DB_HEALTH_TIMEOUT_MS=2000

# --- forwarding（Chatwork → Slack 転送）---
# Chatwork Webhook 署名検証用トークン（base64・秘密。実値は書かない）
CHATWORK_WEBHOOK_TOKEN=
# Chatwork API（GET /rooms 等）用トークン（秘密。実値は書かない）
CHATWORK_API_TOKEN=
# Slack 投稿用 Bot トークン（chat:write スコープ・秘密。実値は書かない）
SLACK_BOT_TOKEN=
# group 種別の集約フォールバック Slack チャンネル ID（設定値）
SLACK_DEFAULT_GROUP_CHANNEL_ID=
# direct 種別の集約フォールバック Slack チャンネル ID（設定値）
SLACK_DEFAULT_DM_CHANNEL_ID=

# --- gcp backend 利用時のみ（SECRET_BACKEND=gcp）---
# 上記トークンを格納する Secret Manager のシークレット「名」（実値ではなく名前）
# CHATWORK_WEBHOOK_TOKEN_SECRET=
# CHATWORK_API_TOKEN_SECRET=
# SLACK_BOT_TOKEN_SECRET=
